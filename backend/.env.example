# Environment variable reference for the FastAPI backend (apps/api).
# See docs/deployment.md §1 for the full narrative reference.
#
# Copy this file to `.env` and fill in real values — never commit `.env` itself.
# NOT loaded automatically — pydantic-settings (BaseSettings) reads directly from the process
# environment, no env_file wired up. Export these before running uvicorn/alembic, e.g.:
#   set -a; source .env; set +a; python -m uvicorn apps.api.main:app --port 8000
#
# Every value below is a placeholder — none of these are real secrets.

# -- Database ---------------------------------------------------------------------------------
# Postgres (Supabase) for a real deployment: postgresql+asyncpg://postgres:<password>@<host>:5432/postgres
# SQLite for fast local dev/tests: sqlite+aiosqlite:///./dev.db
TITANIQ_DB_URL=sqlite+aiosqlite:///./dev.db
# Optional — SQL echo logging. Defaults to false.
TITANIQ_DB_ECHO=false
# Optional — connection pool size. Defaults to 10.
TITANIQ_DB_POOL_SIZE=10

# -- Redis (feature store, ingestion cache/locks, rate limiting) ------------------------------
TITANIQ_REDIS_URL=redis://127.0.0.1:6379/0

# -- Encryption ---------------------------------------------------------------------------------
# Fernet.generate_key() — used to encrypt provider credentials and webhook signing secrets at
# rest. Generate a fresh key per environment; never reuse the same key across deployments.
TITANIQ_ENCRYPTION_KEY=

# -- Supabase Auth (JWT validation) --------------------------------------------------------------
TITANIQ_SUPABASE_PROJECT_URL=https://<your-project-ref>.supabase.co
# Optional — JWKS cache TTL in seconds. Defaults to 3600.
TITANIQ_SUPABASE_JWKS_CACHE_SECONDS=3600

# -- CORS -----------------------------------------------------------------------------------------
# Comma-separated allowlist of origins permitted to call this API from a browser.
TITANIQ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# -- Offline/bcrypt auth path (/auth/register, /auth/login) ---------------------------------------
# Defaults OFF everywhere (Security Milestone finding H-4: this path has no email-verification
# enforcement, so it must never be silently reachable in production). Set to "true" only for
# local/non-Supabase dev or the offline test suite — see apps/api/routers/identity_router.py.
TITANIQ_ENABLE_OFFLINE_AUTH=false
