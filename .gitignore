# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/

# Node / frontend
node_modules/
dist/
.vite/
coverage/
test-results/

# Python build/test artifacts
.coverage
catboost_info/

# Celery Beat's local persistent schedule state (sqlite-backed shelve db) — runtime state, not
# source; regenerated on first Beat startup.
celerybeat-schedule*

# Local dev database — dev.db itself plus every backup/snapshot naming convention used across
# this project's history (dev.db.bak-<ts>-<desc>, dev.db.bak_before_<desc>_<ts>,
# dev.db.snapshot_before_<desc>). The single `dev.db*` glob is deliberately broad so a future
# one-off naming choice doesn't silently reopen this gap the way the underscore variants did.
dev.db*

# Env / secrets
.env
.env.*
!.env.example

# Claude Code local settings — "local" is the project's own naming convention for
# machine-specific config never meant to be shared; this one has recorded real exported secret
# values from past shell commands (e.g. TITANIQ_ENCRYPTION_KEY) in its permissions allowlist.
.claude/settings.local.json

# Capacitor native projects — android/ and ios/ themselves ARE committed (Capacitor's own
# convention: they hold real project config, not just generated output), only their per-machine
# build/dependency-cache output is excluded here.
frontend/android/app/build/
frontend/android/.gradle/
frontend/android/local.properties
frontend/ios/App/Pods/
frontend/ios/App/build/
frontend/ios/DerivedData/
frontend/**/*.xcuserstate
frontend/**/xcuserdata/

# OS
.DS_Store
Thumbs.db
